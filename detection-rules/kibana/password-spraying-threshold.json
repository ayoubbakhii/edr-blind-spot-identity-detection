{
  "rule_id": "edr-blindspot-password-spraying",
  "name": "Password Spraying - One source IP authenticating to many accounts",
  "description": "Detects password spraying (and the enumeration that precedes it) by its pattern, not its volume: a single source IP performing network logons (event 4624, logon type 3) on 3 or more distinct accounts within the rule's look-back window.",
  "type": "threshold",
  "language": "kuery",
  "index": ["winlogbeat-*"],
  "query": "event.code: \"4624\" and winlog.event_data.LogonType: \"3\"",
  "threshold": {
    "field": ["winlog.event_data.IpAddress"],
    "value": 1,
    "cardinality": [
      {
        "field": "winlog.event_data.TargetUserName",
        "value": 3
      }
    ]
  },
  "interval": "1m",
  "from": "now-2m",
  "severity": "high",
  "risk_score": 73,
  "enabled": true,
  "tags": ["Identity", "Brute Force", "Active Directory", "Alert only: no auto-response"],
  "false_positives": ["Jump servers, file servers or monitoring tools that legitimately authenticate many users. Exclude them by IP after baselining."],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      },
      "technique": [
        {
          "id": "T1110",
          "name": "Brute Force",
          "reference": "https://attack.mitre.org/techniques/T1110/",
          "subtechnique": [
            {
              "id": "T1110.003",
              "name": "Password Spraying",
              "reference": "https://attack.mitre.org/techniques/T1110/003/"
            }
          ]
        }
      ]
    }
  ]
}
